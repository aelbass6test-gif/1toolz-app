rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Security Functions ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // --- Stores Configuration and Data ---
    match /stores_data/{storeId} {
      allow read: if isValidId(storeId);
      allow write: if isSignedIn() && isValidId(storeId);
      
      match /{allChildren=**} {
        allow read: if isValidId(storeId);
        allow write: if isSignedIn();
      }
    }

    // --- Products (Storefront Catalog & Admin) ---
    match /products/{productId} {
      allow read: if isValidId(productId);
      allow write: if isSignedIn() && isValidId(productId);
    }

    // --- Orders (Public Storefront Placement & Store Staff Management) ---
    match /orders/{orderId} {
      // Customer orders reading is restricted to authenticated store operators
      allow read: if isSignedIn() && isValidId(orderId);
      // Public customer can create orders via storefront checkout
      allow create: if isValidId(orderId);
      // Only authenticated store operators/admins can update or delete orders
      allow update, delete: if isSignedIn() && isValidId(orderId);
    }

    // --- Customers & Profiles ---
    match /customers/{customerId} {
      // Allow read/write for authenticated store operators or authenticated users
      allow read, write: if isSignedIn() && isValidId(customerId);
    }

    // --- Users & Team Directory ---
    match /users/{userId} {
      // Protect user document creation/updates and directory lookups
      allow read, write: if isSignedIn() && isValidId(userId);
    }

    // --- Employees ---
    match /employees/{employeeId} {
      allow read, write: if isSignedIn() && isValidId(employeeId);
    }

    // --- Maintenance Requests ---
    match /maintenance_requests/{requestId} {
      allow read, write: if isSignedIn() && isValidId(requestId);
    }

    // --- Shared Reports ---
    match /shared_reports/{reportId} {
      allow read: if isValidId(reportId);
      allow create: if isValidId(reportId);
      allow update, delete: if isSignedIn() && isValidId(reportId);
    }

    // --- Partner Requests (Partner Portal Submission & Admin Management) ---
    match /partner_requests/{requestId} {
      allow create: if isValidId(requestId);
      allow read, update, delete: if isSignedIn() && isValidId(requestId);
    }

    // --- Shared Inventory Audits ---
    match /shared_audits/{auditId} {
      allow read: if isValidId(auditId);
      allow write: if isSignedIn() && isValidId(auditId);
      
      match /{allAuditChildren=**} {
        allow read, write: if isSignedIn();
      }
    }
    
    // --- Global collections (transactions, treasury, warehouses, returns) ---
    match /{collectionName}/{docId} {
      allow read, write: if isSignedIn() && isValidId(docId);
    }

    // Explicit deny for any undefined root paths
    match /{allPaths=**} {
      allow read, write: false;
    }
  }
}
